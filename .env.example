# =====================================================================
#  Policy Assistant - local configuration (.env)
#  Place this file in the project root (next to requirements.txt).
#  Every value below matches a field in app/core/config.py.
# =====================================================================

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
APP_NAME=Policy Assistant
APP_ENV=local
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# Paths default to folders inside the project (data/, logs/, prompts/, eval/).
# Uncomment only if you want them somewhere else (use forward slashes on Windows):
# DATA_DIR=C:/PolicyAssistant/data
# LOG_DIR=C:/PolicyAssistant/logs
# DATABASE_URL=sqlite:///C:/PolicyAssistant/data/app.db

# ---------------------------------------------------------------------
# Security / login
# ---------------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=20

# These two accounts are created automatically on the FIRST start only.
# Changing them later has no effect on accounts that already exist.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
BOOTSTRAP_USER_USERNAME=employee
BOOTSTRAP_USER_PASSWORD=Employee@123

# ---------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500

# ---------------------------------------------------------------------
# Vector database (Qdrant)
# ---------------------------------------------------------------------
# local  = embedded Qdrant stored in data/qdrant_local - NO Docker needed (set here)
# server = Qdrant in Docker: run "docker compose up -d qdrant", then set QDRANT_MODE=server
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=policy_chunks
HNSW_M=16
HNSW_EF_CONSTRUCT=200
SEARCH_HNSW_EF=128
USE_SCALAR_QUANTIZATION=true

# ---------------------------------------------------------------------
# Embedding model + reranker (downloaded once from HuggingFace, then offline)
# ---------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
EMBEDDING_BATCH_SIZE=32
# cpu | cuda (NVIDIA GPU) | mps (Apple Silicon)
EMBEDDING_DEVICE=cpu
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Faster on a slow laptop: RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_MAX_LENGTH=512

# ---------------------------------------------------------------------
# Chunking (re-index policies after changing these)
# ---------------------------------------------------------------------
CHILD_CHUNK_TOKENS=350
CHILD_CHUNK_OVERLAP_TOKENS=60
PARENT_CHUNK_TOKENS=1200
MIN_CHUNK_TOKENS=25

# ---------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------
RETRIEVAL_CANDIDATES_PER_QUERY=20
FUSED_CANDIDATES=20
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.15
CONTEXT_MAX_TOKENS=3000
HISTORY_TURNS=6
QUERY_REWRITE_ENABLED=true
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=2
HYDE_ENABLED=false

# ---------------------------------------------------------------------
# LLM (Ollama - already installed on your laptop)
# Pull the models once:  ollama pull llama3.1:8b
#                        ollama pull qwen2.5:3b
#                        ollama pull qwen2.5:7b
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_FALLBACK_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------
MAX_QUERY_CHARS=1000
MIN_QUERY_CHARS=3
INJECTION_MODEL_ENABLED=true
INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
INJECTION_THRESHOLD=0.90
GROUNDEDNESS_MIN=0.35
GROUNDEDNESS_WARN=0.55

# ---------------------------------------------------------------------
# Self-evaluation + DeepEval evaluation
# ---------------------------------------------------------------------
SELF_EVAL_ENABLED=true
EVAL_JUDGE_MODEL=qwen2.5:7b
EVAL_THRESHOLD=0.6
# Keep DeepEval fully offline (no telemetry)
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# ---------------------------------------------------------------------
# UI
# ---------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
